<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Suspended</title>
    <link rel="icon" href="https://indiahost.co/assets/ioc/favicon-32x32.png" type="image/png">
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.6.1/gsap.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <script>
    function displayWebsiteName() {
        var websiteName = window.location.hostname;
        var parts = websiteName.split('.');
        var isIP = /^(?:\d{1,3}\.){3}\d{1,3}$/.test(websiteName);


    if (isIP) {
        websiteName = "Root IP";
    } else {
        if (parts.length > 2) {
            websiteName = parts.slice(-2).join('.');
        }
    }

    document.getElementById("websiteName").innerHTML = websiteName;
    var whatsappMessage = "Need help! My account is suspended, For Domain " + websiteName;
    var whatsappURL = "https://indiahost.co/dash/submitticket.php";
    document.getElementById("whatsappLink").href = whatsappURL;

}
</script>

</head>

<body class="min-h-screen bg-gradient-to-br from-red-100 via-yellow-100 to-orange-100 flex flex-col items-center justify-center p-4 sm:p-8 md:p-16" onload="displayWebsiteName()">

<div class="w-full max-w-5xl bg-white rounded-3xl shadow-2xl p-6 sm:p-8 md:p-12 border border-opacity-30 border-gray-300">
    <h1 class="text-4xl sm:text-6xl md:text-8xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-yellow-500 text-center mb-4 sm:mb-6">
    Account Suspended
</h1>
<p class="text-lg sm:text-xl md:text-2xl text-red-600 text-center mb-4 sm:mb-6" id="websiteName">
</p>

    <p class="text-base sm:text-lg md:text-xl text-gray-600 text-center mb-6 sm:mb-10">
        Please Renew Or Pay Your Bills To Reactivate Your CPanel. It Was Suspended Due To Non-Payment Or Policy Violation</p>
    
    <p class="text-base sm:text-lg md:text-xl text-gray-600 text-center mb-4 sm:mb-6">
        <strong>Renew Your Hosting Plan</strong>
    </p>

    <div class="flex justify-center mb-8 sm:mb-12 md:mb-16">
        <button class="bg-gradient-to-r from-red-500 to-yellow-600 text-white font-bold py-3 px-6 sm:py-4 sm:px-8 rounded-full transition duration-300 flex items-center space-x-2 hover:shadow-lg hover:from-red-600 hover:to-yellow-700 text-sm sm:text-base">
            <i class="fas fa-exclamation-triangle text-lg sm:text-xl"></i>
            <a href="https://indiahost.co/dash/clientarea.php?action=invoices"><span>Pay at India Host >></span></a>
            <i class="fas fa-arrow-right ml-2"></i>
        </button>
    </div>

    <div class="flex justify-center mb-8 sm:mb-12 md:mb-16">
        <a id="whatsappLink" target="_blank" class="bg-gradient-to-r from-green-500 to-green-600 text-white font-bold py-3 px-6 sm:py-4 sm:px-8 rounded-full transition duration-300 flex items-center space-x-2 hover:shadow-lg hover:from-green-600 hover:to-green-700 text-sm sm:text-base">
    <i class="fab fa-whatsapp text-lg sm:text-xl"></i>
    <span>Contact Us</span>
</a>

    </div>

    <div class="w-full h-px bg-gradient-to-r from-transparent via-gray-400 to-transparent mb-8 sm:mb-12"></div>

    <footer class="mt-8 sm:mt-12 text-center text-gray-600 text-sm sm:text-base">
        <p>&copy; India Host - 2025</p>
    </footer>
</div>


</body>

</html>
